// Step 3 TMDL script.
//
// Purpose:
// Point Global_Inflow_Outflow at the amount view and restore measure switching
// between Active Qty and Amount ($).

createOrReplace

    ref table Global_Inflow_Outflow

        column 'S/O Amt' = if(Global_Inflow_Outflow[ASP] = blank(), blank(), Global_Inflow_Outflow[ASP] * Global_Inflow_Outflow[Active Qty])
            summarizeBy: sum

        column 'Domestic Demand Amt' = Global_Inflow_Outflow[Domestic Demand] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'From MENA Amt' = Global_Inflow_Outflow[From MENA] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'From Non-MENA Amt' = Global_Inflow_Outflow[From Non-MENA] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'S/O SCM Amt' = Global_Inflow_Outflow[S/O SCM] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'S/O that Stays Amt' = Global_Inflow_Outflow[S/O that Stays] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'To MENA Outflow Amt' = Global_Inflow_Outflow[To MENA Outflow] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'To Non-MENA Amt' = Global_Inflow_Outflow[To Non-MENA] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'Total Inflow Amt' = Global_Inflow_Outflow[Total Inflow] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'Total Outflow Amt' = Global_Inflow_Outflow[Total Outflow] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column '2nd Activation In Amt' = Global_Inflow_Outflow[2nd Activation In] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column '2nd Activation Out Amt' = Global_Inflow_Outflow[2nd Activation Out] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'CI In Amt' = Global_Inflow_Outflow[CI In] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'CI Out Amt' = Global_Inflow_Outflow[CI Out] * Global_Inflow_Outflow[ASP]
            summarizeBy: sum

        column 'Parallel S/O Amt' =
                if(Global_Inflow_Outflow[Sell-in Region] <> "MIDDLE EAST", Global_Inflow_Outflow[Total Inflow Amt] + Global_Inflow_Outflow[Total Outflow Amt], if(and(Global_Inflow_Outflow[Current Region] <> "MIDDLE EAST", Global_Inflow_Outflow[Sell-in Region] = "MIDDLE EAST"), Global_Inflow_Outflow[Total Outflow Amt], Global_Inflow_Outflow[Total Inflow Amt]))
            summarizeBy: sum

        partition Global_Inflow_Outflow = m
            mode: import
            source =
                    let
                        Source = PostgreSQL.Database("SERVER_NAME", "DATABASE_NAME"),
                        Step3Amount = Value.NativeQuery(
                            Source,
                            "
                            select
                                ""Source Side"",
                                ""Sell-in Region"",
                                ""Sell-in Sub"",
                                ""Sell-in AP1"",
                                ""Sell-in Account"",
                                ""Sell-out Region"",
                                ""Sell-out Sub"",
                                ""Sell-out Country"",
                                ""Current Region"",
                                ""Current Sub"",
                                ""Current Country"",
                                ""Biz Sub"",
                                ""Series"",
                                ""MKT Name"",
                                ""Memory"",
                                ""Storage"",
                                ""Item Code"",
                                ""Month"",
                                ""Year"",
                                ""ItemID"",
                                ""Grand total"",
                                ""ASP"",
                                ""Biz Grp"",
                                ""Sell-in Channel"",
                                ""Sell-in Country"",
                                ""SKU"",
                                ""In/Out"",
                                ""Region"",
                                ""Subsidiary"",
                                ""Active Qty"",
                                ""Total Inflow"",
                                ""From MENA"",
                                ""From Non-MENA"",
                                ""Total Outflow"",
                                ""To MENA Outflow"",
                                ""To Non-MENA"",
                                ""S/O SCM"",
                                ""Domestic Demand"",
                                ""S/O that Stays"",
                                ""2nd Activation In"",
                                ""2nd Activation Out"",
                                ""CI In"",
                                ""CI Out""
                            from bi_reporting.io_3_amount_mv
                            ",
                            null,
                            [EnableFolding = true]
                        )
                    in
                        Step3Amount

    ref table Formulas

        measure 'Total Inflow' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[Total Inflow]), sum(Global_Inflow_Outflow[Total Inflow Amt]))
            formatString: #,0

        measure 'From MENA' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[From MENA]), sum(Global_Inflow_Outflow[From MENA Amt]))
            formatString: #,0

        measure 'From non-MENA' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[From Non-MENA]), sum(Global_Inflow_Outflow[From Non-MENA Amt]))
            formatString: #,0

        measure 'Total Outflow' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[Total Outflow]), sum(Global_Inflow_Outflow[Total Outflow Amt]))
            formatString: #,0

        measure 'To MENA' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[To MENA Outflow]), sum(Global_Inflow_Outflow[To MENA Outflow Amt]))
            formatString: #,0

        measure 'To non-MENA' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[To Non-MENA]), sum(Global_Inflow_Outflow[To Non-MENA Amt]))
            formatString: #,0

        measure 'S/O SCM' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[S/O SCM]), sum(Global_Inflow_Outflow[S/O SCM Amt]))
            formatString: #,0

        measure 'Domestic Demand' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[Domestic Demand]), sum(Global_Inflow_Outflow[Domestic Demand Amt]))
            formatString: #,0

        measure 'S/O that Stays' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[S/O that Stays]), sum(Global_Inflow_Outflow[S/O that Stays Amt]))
            formatString: #,0

        measure '2nd Activation In' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[2nd Activation In]), sum(Global_Inflow_Outflow[2nd Activation In Amt]))
            formatString: #,0

        measure '2nd Activation Out' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[2nd Activation Out]), sum(Global_Inflow_Outflow[2nd Activation Out Amt]))
            formatString: #,0

        measure 'CI In' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[CI In]), sum(Global_Inflow_Outflow[CI In Amt]))
            formatString: #,0

        measure 'CI Out' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[CI Out]), sum(Global_Inflow_Outflow[CI Out Amt]))
            formatString: #,0

        measure 'Parallel S/O' =
                var selectedmetric = selectedvalue(MeasureSelect[Measure], "Active Qty")
                return if(selectedmetric = "Active Qty", sum(Global_Inflow_Outflow[Parallel S/O]), sum(Global_Inflow_Outflow[Parallel S/O Amt]))
            formatString: #,0
